    { "name": "first_pending", "layer": "kernel", "category": "planning", "scope": { "kind": "public", "path": ["kernel", "planning"] } },
    { "name": "transition_allowed", "layer": "kernel", "category": "planning", "scope": { "kind": "public", "path": ["kernel", "planning"] } },
