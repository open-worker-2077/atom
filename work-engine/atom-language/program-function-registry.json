    { "name": "work_order", "layer": "application", "category": "work-order", "scope": { "kind": "public", "path": ["application", "work-order"] } },
    { "name": "work_order_catalog", "layer": "application", "category": "work-order", "scope": { "kind": "public", "path": ["application", "work-order"] } }
  ]
}
