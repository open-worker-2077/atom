    { "name": "direct_children", "layer": "kernel", "category": "graph-read", "scope": { "kind": "public", "path": ["kernel", "graph-read"] } },
    { "name": "child_detail", "layer": "kernel", "category": "graph-read", "scope": { "kind": "public", "path": ["kernel", "graph-read"] } },
    { "name": "subtree_refs", "layer": "kernel", "category": "graph-read", "scope": { "kind": "public", "path": ["kernel", "graph-read"] } },
