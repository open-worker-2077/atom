    { "layer": "kernel", "id": "graph-governance", "label": "Graph 约束" },
    { "layer": "kernel", "id": "interaction", "label": "交互结果" },
    { "layer": "kernel", "id": "execution", "label": "Program 执行与组合" },
    { "layer": "kernel", "id": "graph-read", "label": "Graph 读取辅助" },
    { "layer": "kernel", "id": "structure-constraint", "label": "结构与约束" },
    { "layer": "kernel", "id": "planning", "label": "通用规划" },
